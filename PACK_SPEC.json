{
  "schema_version": "WPACK_SPEC_v1.3",
  "display_name": "W-Pack",
  "pack_id": "WPACK",
  "pack_version": "WPACK_v0.5.1-chat-native",
  "scope": "CHATGPT_WEB_PROJECT_IMAGE_GENERATION_HARNESS",
  "repository": "chano-gpt/w-pack",
  "reference_slot_limit": 5,
  "generation_transport": "CHATGPT_BUILTIN_IMAGE_GENERATION",
  "standalone_api_allowed": false,
  "api_key_required": false,
  "local_gpu_required": false,
  "authority_roles": ["STYLE", "CHARACTER", "POSE", "COMPOSITION", "PROPORTION", "ITEM"],
  "internal_authority_roles": ["STYLE_CORE", "STYLE_SUPPORT", "STRUCTURE_EDIT_TARGET"],
  "reference_sources": ["PROJECT_AUTHORITY", "INLINE_AUTHORITY"],
  "reference_transport_states": [
    "VISUAL_BOUND",
    "VISUAL_INPUT_EXPECTED",
    "PROJECT_CONTEXT_ONLY",
    "TEXT_PROFILE_ONLY",
    "UNVERIFIED_PROJECT_SOURCE",
    "UNAVAILABLE"
  ],
  "manifest_schema": "WPACK_AUTHORITY_MANIFEST_v1.1",
  "compatible_manifest_schemas": ["WPACK_AUTHORITY_MANIFEST_v1.0", "WPACK_AUTHORITY_MANIFEST_v1.1"],
  "request_schema": "WPACK_GENERATION_REQUEST_v1.2",
  "compatible_request_schemas": [
    "WPACK_GENERATION_REQUEST_v1.0",
    "WPACK_GENERATION_REQUEST_v1.1",
    "WPACK_GENERATION_REQUEST_v1.2"
  ],
  "compiled_request_schema": "WPACK_COMPILED_REQUEST_v1.3",
  "style_audit_schema": "WPACK_STYLE_AUDIT_v1.1",
  "style_recovery_schema": "WPACK_STYLE_RECOVERY_REQUEST_v1.1",
  "generation_modes": ["FRESH", "EDIT"],
  "generation_policy": {
    "fresh_generation_default": true,
    "project_sources_default_active": true,
    "project_membership_is_visual_binding_proof": false,
    "reference_binding_verification_required": true,
    "text_style_dna_fallback_allowed": true,
    "text_fallback_may_claim_exact_visual_fidelity": false,
    "inline_references_secondary": true,
    "previous_candidate_reuse_default": false,
    "style_fidelity_default": "HIGH",
    "style_core_precedence": "ABSOLUTE_FOR_GLOBAL_VISUAL_GRAMMAR",
    "photorealism_normalization_with_style_core": "DISABLED_UNLESS_EXPLICITLY_REQUESTED",
    "style_fingerprint_axes": [
      "visual_medium",
      "degree_of_realism",
      "edge_grammar",
      "shape_abstraction",
      "value_structure",
      "color_behavior",
      "surface_treatment",
      "background_rendering",
      "hair_rendering_grammar"
    ],
    "hair_rendering_default": "CLEAN_MASS_WHEN_UNSPECIFIED",
    "hair_rendering_high_salience_audit": true
  },
  "style_family_policy": {
    "mode": "ONE_CORE_PLUS_BOUNDED_SUPPORT",
    "maximum_style_references": 3,
    "maximum_support_references": 2,
    "support_may_override_core": false,
    "core_only_axes": ["visual_medium", "degree_of_realism", "shape_abstraction"],
    "preferred_first_pass_support_count": 1,
    "inline_style_replaces_project_family_by_default": true,
    "combine_style_sources_requires_explicit_request": true
  },
  "hair_rendering_policy": {
    "macro_to_micro_order": ["silhouette", "major_locks", "internal_texture", "micro_strands"],
    "default_micro_strand_density": "SPARSE",
    "default_flyaway_density": "SPARSE_PHYSICALLY_MOTIVATED",
    "default_tip_behavior": "GROUPED_NOT_REPEATEDLY_FORKED",
    "default_highlight_granularity": "LOCK_LEVEL",
    "source_authority_overrides_default": true
  },
  "workflow_policy": {
    "default_mode": "FRESH_FIRST",
    "two_stage_default": false,
    "conditional_style_recovery": true,
    "style_recovery_trigger": "STRUCTURE_PASS_AND_STYLE_FAIL",
    "style_recovery_method": "SINGLE_RESTYLE",
    "style_recovery_requires_visual_binding_or_style_dna": true,
    "maximum_restyle_depth": 1,
    "recovery_reference_roles": ["STRUCTURE_EDIT_TARGET", "STYLE_CORE", "OPTIONAL_STYLE_SUPPORT"],
    "maximum_support_adapters_in_recovery": 1,
    "automatic_third_pass_allowed": false,
    "automatic_fresh_retry_after_recovery_failure": false
  },
  "validation": {
    "manifest_and_request_validator": "skill/scripts/validate_authorities.py",
    "request_and_recovery_compiler": "skill/scripts/compile_request.py",
    "self_test": "skill/scripts/self_test.py"
  },
  "project_policy": {
    "reference_source": "PROJECT_CATALOG_PRIMARY_CURRENT_CHAT_SECONDARY",
    "visual_binding_assumption": "NEVER_IMPLICIT",
    "manifest_path": "project/AUTHORITY_MANIFEST.example.json",
    "request_example_path": "project/GENERATION_REQUEST.example.json",
    "instructions_path": "project/PROJECT_INSTRUCTIONS.md"
  },
  "legacy_runtime": {
    "path": "src/zpack",
    "status": "PROVENANCE_ONLY_NOT_EXECUTED",
    "cli_exposed": false
  }
}
