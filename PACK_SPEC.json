{
  "schema_version": "WPACK_SPEC_v1.2",
  "display_name": "W-Pack",
  "pack_id": "WPACK",
  "pack_version": "WPACK_v0.4.0-chat-native",
  "scope": "CHATGPT_WEB_PROJECT_IMAGE_GENERATION_HARNESS",
  "repository": "chano-gpt/w-pack",
  "reference_slot_limit": 5,
  "generation_transport": "CHATGPT_BUILTIN_IMAGE_GENERATION",
  "standalone_api_allowed": false,
  "api_key_required": false,
  "local_gpu_required": false,
  "authority_roles": ["STYLE", "CHARACTER", "POSE", "COMPOSITION", "PROPORTION", "ITEM"],
  "internal_authority_roles": ["STYLE_CORE", "STRUCTURE_EDIT_TARGET"],
  "reference_sources": ["PROJECT_AUTHORITY", "INLINE_AUTHORITY"],
  "request_schema": "WPACK_GENERATION_REQUEST_v1.1",
  "compiled_request_schema": "WPACK_COMPILED_REQUEST_v1.2",
  "style_audit_schema": "WPACK_STYLE_AUDIT_v1.0",
  "style_recovery_schema": "WPACK_STYLE_RECOVERY_REQUEST_v1.0",
  "generation_modes": ["FRESH", "EDIT"],
  "generation_policy": {
    "fresh_generation_default": true,
    "project_sources_default_active": true,
    "default_profile_fallback_name": "DEFAULT",
    "inline_references_secondary": true,
    "explicit_same_role_reference_overrides_profile_default": true,
    "previous_candidate_reuse_default": false,
    "style_core_required_for_automatic_recovery": true,
    "style_fidelity_default": "HIGH",
    "style_medium_lock_default": "REFERENCE",
    "style_core_precedence": "ABSOLUTE_FOR_GLOBAL_VISUAL_GRAMMAR",
    "photorealism_normalization_with_style_core": "DISABLED_UNLESS_EXPLICITLY_REQUESTED"
  },
  "workflow_policy": {
    "default_mode": "FRESH_FIRST",
    "two_stage_default": false,
    "conditional_style_recovery": true,
    "style_recovery_trigger": "STRUCTURE_PASS_AND_STYLE_FAIL",
    "style_recovery_method": "SINGLE_RESTYLE",
    "maximum_restyle_depth": 1,
    "recovery_reference_roles": ["STRUCTURE_EDIT_TARGET", "STYLE_CORE"],
    "automatic_third_pass_allowed": false,
    "automatic_fresh_retry_after_recovery_failure": false
  },
  "validation": {
    "manifest_and_request_validator": "skill/scripts/validate_authorities.py",
    "request_and_recovery_compiler": "skill/scripts/compile_request.py",
    "self_test": "skill/scripts/self_test.py"
  },
  "project_policy": {
    "reference_source": "CHATGPT_PROJECT_FILES_PRIMARY_CURRENT_CONVERSATION_UPLOADS_SECONDARY",
    "manifest_path": "project/AUTHORITY_MANIFEST.example.json",
    "request_example_path": "project/GENERATION_REQUEST.example.json",
    "instructions_path": "project/PROJECT_INSTRUCTIONS.md"
  },
  "legacy_runtime": {
    "path": "src/zpack",
    "status": "PROVENANCE_ONLY_NOT_EXECUTED",
    "cli_exposed": false
  }
}
